# Copy this file to ".env" (never commit .env). Everything here is OPTIONAL.
# The app works fully WITHOUT any key; the LLM only adds a second opinion.

# Placeholder only - paste your own key locally if you want the LLM signal:
ANTHROPIC_API_KEY=your_api_key_here

